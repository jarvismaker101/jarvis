# ── Credentials ───────────────────────────────────────────────────────────
# Copy this file to `.env` (same folder, gitignored) and fill in the values.
# `.env` is the ONLY place the app reads credentials from: backend/config.py
# calls load_dotenv(<repo>/.env, override=True) at import, so an environment
# variable set in Windows is silently overridden by whatever is in this file.
# An empty value counts as "missing" and the affected feature is disabled.
#
# Which ones you actually need depends on the models selected in the UI
# (data/jarvis_settings.json). The stock selections use `fireworks` for chat,
# vision and the browser tool model, and `fish` for TTS — so FIREWORKS_API_KEY
# and FISH_API_KEY are the two that matter most.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ELEVENLABS_API_KEY=
FISH_API_KEY=
FIREWORKS_API_KEY=
CLINE_API_KEY=
# Inworld STT (optional). Without it, speech is transcribed locally by the
# Whisper daemon, which is the default fallback and needs no key.
INWORLD_STT_API_KEY=
FISH_REFERENCE_ID=
JARVIS_FISH_TTS_VOLUME_BOOST_DB=6

# Model overrides
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_INTENT_MODEL=qwen/qwen3.6-27b
GROQ_STT_MODEL=whisper-large-v3-turbo
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
GEMINI_BRAIN_MODEL=gemini-3.5-flash-lite
FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4-flash-0731
FIREWORKS_REASONING_EFFORT=none

# Voice and microphone
JARVIS_STT_LANGUAGES=en-IN,hi-IN
JARVIS_MIC_DEVICE_INDEX=
JARVIS_MIC_NAME=
JARVIS_WATCHER_ENERGY_THRESHOLD=80
JARVIS_PREFER_LOCAL_TTS=1
JARVIS_LOCAL_TTS_RATE=180
JARVIS_REMOTE_TTS_CHAR_LIMIT=150
JARVIS_FISH_TTS_CHAR_LIMIT=1800
# The voice engine is chosen per-role in the UI (VOICE MODEL / TTS section):
#   Fish Audio        - metered, high quality, needs FISH_API_KEY
#   Google TTS (free)- key-less fallback, no account and no billing
# Each engine chunks long sentences at its own limit; this bounds the free one.
JARVIS_GOOGLE_TTS_CHAR_LIMIT=1800
# Google's tw-ob voice is drawly next to Fish. Its PCM is time-stretched to
# this multiple, pitch-preserved (ffmpeg atempo), so it does not sound like
# slow motion. 1.0 disables the stretch; valid range is 0.5-2.0.
JARVIS_GOOGLE_TTS_SPEED=1.5

# TTS output routing. Unset = Windows default render device. Pin explicitly by
# sounddevice index (python -m backend.scripts.check_tts_devices lists them) or
# a case-insensitive name substring (e.g. Realtek). NOTE: on Bluetooth headsets,
# keeping the headset mic active can flip the link to Hands-Free and mute the
# stereo sink — if TTS plays "successfully" but you hear nothing, point
# JARVIS_MIC_NAME at the laptop mic, or pin TTS to speakers here.
JARVIS_TTS_OUTPUT_DEVICE=

# Local paths and app overrides
JARVIS_DESKTOP_PATH=
JARVIS_CHROME_PATH=
JARVIS_EDGE_PATH=
JARVIS_BRAVE_PATH=

# Deep research browser (research_service.py). Use msedge/brave when Chrome
# is not installed: JARVIS_RESEARCH_CHANNEL=msedge
JARVIS_RESEARCH_CHANNEL=chrome
JARVIS_RESEARCH_PROFILE=data\chrome_profile_jarvis
JARVIS_RESEARCH_REPORTS=data\research_reports

# Local service ports
JARVIS_BACKEND_PORT=9999
JARVIS_WATCHER_CONTROL_PORT=8766
JARVIS_EDITOR_BRIDGE_PORT=8765
JARVIS_EDITOR_BRIDGE_URL=http://127.0.0.1:8765
JARVIS_EDITOR_BRIDGE_TOKEN=
JARVIS_CDP_URL=http://127.0.0.1:9222

# Brave MCP daemon auth (opencode_client.py). Must match the Authorization
# header the brave-mcp server is started with; leave empty if that server runs
# without a token. Its port is BRAVE_MCP_PORT (default 9570) — set it only to a
# real number, an empty value would fail int() parsing.
BRAVE_MCP_TOKEN=

# opencode integration (used when Jarvis hands off tasks it can't do locally)
JARVIS_OPENCODE_CMD=opencode
JARVIS_OPENCODE_TIMEOUT=180
